{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pulpitry",
  "version": "0.1.0",
  "identifier": "com.pulpitry.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "operator",
        "title": "Pulpitry",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 680,
        "resizable": true,
        "center": true,
        "backgroundColor": "#1C1B18"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "msi",
      "nsis"
    ],
    "category": "Productivity",
    "shortDescription": "Live transcription and worship presentation",
    "longDescription": "Pulpitry transcribes the spoken word live, detects Bible verses as they are quoted or paraphrased, and drives a congregation-facing projector display.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/pulpitry-speech"
    ],
    "resources": [
      "resources/*",
      "resources/embedder/*"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
