{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pulpitry",
  "version": "0.8.8",
  "identifier": "com.pulpitry.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "operator",
        "title": "Pulpitry",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 680,
        "resizable": true,
        "center": true,
        "backgroundColor": "#1C1B18",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,CalculateNativeWinOcclusion --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Ayorinde G. Smart",
    "copyright": "\u00a9 2026 Ayorinde G. Smart",
    "license": "Proprietary",
    "homepage": "https://castavox.com",
    "targets": [
      "app",
      "dmg",
      "msi",
      "nsis",
      "deb",
      "rpm",
      "appimage"
    ],
    "category": "Productivity",
    "shortDescription": "Live transcription and worship presentation",
    "longDescription": "Pulpitry transcribes the spoken word live, detects Bible verses as they are quoted or paraphrased, and drives a congregation-facing projector display.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/*",
      "resources/embedder/*",
      "resources/sidecar/*"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements.plist",
      "hardenedRuntime": false
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libasound2"
        ]
      },
      "rpm": {
        "depends": [
          "alsa-lib"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/aysmart/castavox-downloads/releases/download/pulpitry-latest/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZCMkY5OTYzRDIwMDFENTUKUldSVkhRRFNZNWt2YXdtMXV1cU9lb1BCOUYxUWwvdytVK09KYmdFcld3ZDRZcFY1bHBraCs5Z0wK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
